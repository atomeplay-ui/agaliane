---
import '@fontsource/caladea/400.css';
import '@fontsource/caladea/400-italic.css';
import '@fontsource/caladea/700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site.js';

const { titre = site.titre } = Astro.props;

const favicon = await getImage({ src: logo, width: 96, height: 96, format: 'png' });
const apercu = await getImage({ src: logo, width: 600, height: 600, format: 'png' }); // aperçu lors d'un partage de lien
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={site.description} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={apercu.src} />
    <link rel="icon" type="image/png" href={favicon.src} />
  </head>
  <body>
    <slot />
  </body>
</html>
