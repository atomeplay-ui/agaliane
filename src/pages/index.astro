---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Prestations from '../components/Prestations.astro';
import Concept from '../components/Concept.astro';
import Deroule from '../components/Deroule.astro';
import Tarifs from '../components/Tarifs.astro';
import Reservation from '../components/Reservation.astro';
import Infos from '../components/Infos.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

// Fiche « commerce local » lue par Google (nom, adresse, téléphone). Ajouter les horaires quand ils seront connus.
const commerce = {
  '@context': 'https://schema.org',
  '@type': 'JewelryStore',
  name: site.nom,
  description: site.description,
  url: Astro.site,
  telephone: site.telephoneLien.replace('tel:', ''),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adresse,
    postalCode: '30000',
    addressLocality: 'Nîmes',
    addressCountry: 'FR',
  },
};
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(commerce)} />
  <Header />
  <main>
    <Hero />
    <Prestations />
    <Concept />
    <Deroule />
    <Tarifs />
    <Reservation />
    <Infos />
  </main>
  <Footer />
</Base>
