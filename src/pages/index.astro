---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Prestations from '../components/Prestations.astro';
import Concept from '../components/Concept.astro';
import Deroule from '../components/Deroule.astro';
import Tarifs from '../components/Tarifs.astro';
import Reservation from '../components/Reservation.astro';
import Infos from '../components/Infos.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import { site, legal, faq } from '../data/site.js';

const image = await getImage({ src: logo, width: 600, height: 600, format: 'png' });
const atelier = (name, price) => ({
  '@type': 'Offer',
  price,
  priceCurrency: 'EUR',
  itemOffered: { '@type': 'Service', name: `Atelier créatif (${site.duree}) — ${name}` },
});

// Données lues par Google et les IA : fiche « commerce local » + questions fréquentes.
// Ajouter `sameAs` (Instagram, Facebook, fiche Google…).
const donnees = [
  {
    '@context': 'https://schema.org',
    '@type': 'JewelryStore',
    name: site.nom,
    legalName: legal.raisonSociale,
    description: site.description,
    url: Astro.site,
    image: new URL(image.src, Astro.site),
    logo: new URL(image.src, Astro.site),
    telephone: site.telephoneLien.replace('tel:', ''),
    email: site.email,
    priceRange: '19 € – 45 €',
    currenciesAccepted: 'EUR',
    // Le samedi n'est ouvert qu'un samedi sur deux : non indiqué ici pour ne pas tromper Google.
    openingHoursSpecification: site.horaires
      .filter((h) => h.ouverture && !h.note)
      .map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.en, opens: h.ouverture, closes: h.fermeture })),
    hasMap: site.carte,
    founder: { '@type': 'Person', name: legal.directeurPublication },
    areaServed: ['Nîmes', 'Gard'],
    knowsAbout: ['bijoux fantaisie', 'perles', 'upcycling', 'réparation de bijoux', 'rachat de bijoux', 'atelier création de bijoux'],
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.adresse,
      postalCode: '30000',
      addressLocality: 'Nîmes',
      addressRegion: 'Occitanie',
      addressCountry: 'FR',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Ateliers créatifs de bijoux',
      itemListElement: [
        atelier('collier ras de cou en perles fantaisie', 25),
        atelier('collier standard en perles fantaisie', 35),
        atelier('sautoir en perles fantaisie', 45),
        atelier('bracelet ou boucles d’oreilles en perles fantaisie', 25),
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, r }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: r },
    })),
  },
];
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(donnees)} />
  <Header />
  <main>
    <Hero />
    <Prestations />
    <Concept />
    <Deroule />
    <Tarifs />
    <Reservation />
    <Infos />
    <Faq />
  </main>
  <Footer />
</Base>
