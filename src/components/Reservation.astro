---
import { site, simplybook } from '../data/site.js';
---

<section class="section section--creme" id="reservation">
  <div class="container">
    <p class="surtitre centre">Réservation</p>
    <h2 class="centre">Choisissez votre créneau</h2>
    <p class="centre">Réservez en ligne ci-dessous, ou par téléphone :</p>
    <p class="centre">
      <a href={site.telephoneLien} class="btn">{site.telephone}</a>
    </p>
    <div class="reservation__widget">
      <!-- Le widget SimplyBook insère son iframe à l'emplacement de ce script. Config dans src/data/site.js -->
      <script is:inline src="https://widget.simplybook.it/v2/widget/widget.js"></script>
      <script is:inline define:vars={{ simplybook }}>
        new SimplybookWidget(simplybook);
      </script>
    </div>
  </div>
</section>

<style>
  #reservation {
    padding-top: clamp(4.5rem, 11vw, 8rem);
  }
  .reservation__widget {
    margin-top: 2rem;
    overflow: hidden;
  }
  /* L'iframe est sur le domaine SimplyBook, on ne peut pas la styler de l'intérieur :
     on décale vers le haut pour cacher son en-tête (92 px, menu vide). */
  .reservation__widget :global(iframe) {
    display: block;
    margin-top: -92px;
  }
</style>
