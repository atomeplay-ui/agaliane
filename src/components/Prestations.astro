---
// Icônes : contenu SVG (viewBox 0 0 48 48), tracé au trait.
const prestations = [
  {
    titre: 'Vente',
    texte: 'de bijoux fantaisie, perles et accessoires',
    icone: `<path d="M12 18h24l3 22H9z"/><path d="M18 18v-4a6 6 0 0 1 12 0v4"/>
      <path class="coeur" d="M24 34s-5-3.2-5-6.5a2.7 2.7 0 0 1 5-1.3 2.7 2.7 0 0 1 5 1.3c0 3.3-5 6.500-5 6.500z"/>`,
  },
  {
    titre: 'Réparation et rachat',
    texte: 'de bijoux fantaisie',
    icone: `<path d="M10 40 30 16"/><path d="m26 10 10 8-3 4-10-8z"/>
      <path d="M38 40 22 20"/><path class="coeur" d="M22 20c-4-3-7-8-7-12 4 1 8 4 10 9z"/>`,
  },
  {
    titre: 'Ateliers de création',
    texte: 'de bijoux fantaisie',
    icone: `<circle cx="24" cy="20" r="13" stroke-dasharray="0.1 5.800" stroke-width="4.500"/>
      <path class="coeur" d="M24 44s-4.500-2.900-4.500-5.900a2.400 2.400 0 0 1 4.500-1.200 2.400 2.400 0 0 1 4.500 1.200c0 3-4.500 5.900-4.500 5.900z"/>`,
  },
];
---

<section class="section section--creme" id="prestations">
  <div class="container">
    <p class="surtitre centre">Nos prestations</p>
    <h2 class="centre">À la boutique</h2>
    <ul class="prestations">
      {
        prestations.map((p) => (
          <li>
            <span class="prestations__icone">
              <svg viewBox="0 0 48 48" aria-hidden="true" set:html={p.icone} />
            </span>
            <h3>{p.titre}</h3>
            <p>{p.texte}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .prestations {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    text-align: center;
  }
  .prestations__icone {
    display: inline-grid;
    place-items: center;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: var(--rose);
  }
  .prestations svg {
    width: 60px;
    height: 60px;
    fill: none;
    stroke: var(--brun);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .prestations svg :global(.coeur) {
    stroke: var(--terracotta);
  }
  .prestations h3 {
    margin: 1rem 0 0.25rem;
    font-size: 1.4rem;
  }
  .prestations p {
    margin: 0 auto;
    max-width: 22ch;
  }
  @media (max-width: 700px) {
    .prestations {
      margin-top: 2rem;
    }
    .prestations__icone {
      width: 80px;
      height: 80px;
    }
    .prestations svg {
      width: 44px;
      height: 44px;
    }
  }
</style>
