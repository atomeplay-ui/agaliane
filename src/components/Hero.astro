---
import { Image } from 'astro:assets';
import boucles from '../assets/hero-boucles.png';
import { site } from '../data/site.js';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div>
      <p class="surtitre">Atelier de bijoux · Nîmes</p>
      <h1>Créez votre bijou, de vos propres mains</h1>
      <p class="hero__texte">
        Réservez un créneau à la boutique, composez votre pièce unique et ajoutez-y vos propres pendentifs.
      </p>
      <div class="hero__actions">
        <a href="#reservation" class="btn">Réserver un créneau</a>
        <a href={site.telephoneLien} class="btn btn--contour">{site.telephone}</a>
      </div>
    </div>
    <!-- Affichée à 340 px max : au-delà, l'image source (680 px) deviendrait floue sur écran Retina. -->
    <Image
      src={boucles}
      alt="Boucles d’oreilles clip dorées serties de pierres colorées"
      width={340}
      densities={[1, 2]}
      loading="eager"
      class="hero__image"
    />
  </div>
</section>

<style>
  .hero {
    /* #fcfcfc = fond de la photo des boucles */
    background: #fcfcfc;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero h1 {
    max-width: 14ch;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1.1;
    margin: 0 0 1.5rem;
  }
  .hero__texte {
    max-width: 38ch;
    font-size: 1.1rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
  .hero__image {
    width: min(340px, 30vw);
    height: auto;
  }
  /* Sur téléphone : texte seul, comme la première version */
  @media (max-width: 700px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__image {
      display: none;
    }
  }
</style>
