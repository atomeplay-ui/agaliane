---
import { site } from '../data/site.js';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <p class="surtitre">{site.adresse} · {site.ville}</p>
    <h1>
      Notre concept : l’upcycling
      <span class="hero__devise">Rien ne se perd, tout se transforme…</span>
    </h1>
    <p class="hero__texte">Réservez un créneau à la boutique, composez votre pièce unique.</p>
    <div class="hero__actions">
      <a href="#reservation" class="btn">Réserver un créneau</a>
      <a href={site.telephoneLien} class="btn btn--contour">{site.telephone}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: #fcfcfc;
  }
  .hero__inner {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    line-height: 1.1;
    margin: 0 0 1.5rem;
  }
  .hero__devise {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.5em;
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
  .hero__texte {
    max-width: 38ch;
    font-size: 1.1rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
