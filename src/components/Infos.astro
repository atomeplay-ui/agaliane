---
import { site } from '../data/site.js';
---

<section class="section" id="infos">
  <div class="container">
    <p class="surtitre centre">Infos pratiques</p>
    <h2 class="centre">Nous trouver</h2>
    <div class="infos">
      <div>
        <h3>Adresse</h3>
        <address>
          {site.adresse}<br />
          {site.ville}
        </address>
        <p><a href={site.carte} target="_blank" rel="noopener">Voir sur la carte</a></p>
      </div>
      <div>
        <h3>Contact</h3>
        <p>
          <a href={site.telephoneLien}>{site.telephone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
      <div>
        <h3>Horaires</h3>
        <table class="horaires">
          {
            site.horaires.map((h) => (
              <tr>
                <th scope="row">{h.jour}</th>
                <td>
                  {h.ouverture ? `${h.ouverture.replace(':', ' h ')} – ${h.fermeture.replace(':', ' h ')}`.replaceAll(' h 00', ' h') : 'Fermé'}
                  {h.note && <small>{h.note}</small>}
                </td>
              </tr>
            ))
          }
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .infos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
    text-align: center;
  }
  address {
    font-style: normal;
  }
  .horaires {
    margin: 0 auto;
    border-collapse: collapse;
  }
  .horaires th,
  .horaires td {
    padding: 0.2rem 0.6rem;
    vertical-align: top;
  }
  .horaires th {
    font-weight: 400;
    text-align: left;
  }
  .horaires td {
    text-align: right;
    white-space: nowrap;
  }
  .horaires small {
    display: block;
    font-style: italic;
  }
</style>
