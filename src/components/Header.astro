---
import { Image } from 'astro:assets';
import logo from '../assets/logo-simple.jpg';
import { site } from '../data/site.js';

const liens = [
  { href: '/#prestations', texte: 'Prestations' },
  { href: '/#concept', texte: 'Le concept' },
  { href: '/#deroule', texte: 'Déroulé' },
  { href: '/#tarifs', texte: 'Tarifs' },
  { href: '/#infos', texte: 'Infos pratiques' },
];
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <Image src={logo} alt={site.nom} width={186} densities={[1, 2]} loading="eager" />
    </a>
    <nav class="header__nav" aria-label="Navigation principale">
      {liens.map((l) => <a href={l.href}>{l.texte}</a>)}
      <a href="/#reservation" class="btn btn--small">Réserver</a>
      <button type="button" class="header__menu-btn" popovertarget="menu-mobile" aria-label="Ouvrir le menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      </button>
    </nav>
  </div>
</header>

<!-- Menu téléphone : panneau natif (popover) qui descend depuis le haut de l'écran. -->
<nav class="menu-mobile" id="menu-mobile" popover aria-label="Menu">
  <button type="button" class="menu-mobile__fermer" popovertarget="menu-mobile" aria-label="Fermer le menu">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
  </button>
  {liens.map((l) => <a href={l.href}>{l.texte}</a>)}
  <a href="/#reservation" class="btn">Réserver un créneau</a>
  <a href={site.telephoneLien} class="btn btn--contour">{site.telephone}</a>
</nav>

<script is:inline>
  // Referme le menu quand on choisit un lien.
  document.getElementById('menu-mobile').addEventListener('click', (e) => {
    if (e.target.closest('a')) e.currentTarget.hidePopover();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--blanc);
    border-bottom: 1px solid var(--bordure);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
  }
  .header__logo img {
    display: block;
    height: 88px;
    width: auto;
  }
  .header__nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1.5rem;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .header__nav a:not(.btn) {
    color: var(--texte-fort);
    text-decoration: none;
  }
  .header__nav a:not(.btn):hover {
    color: var(--accent);
  }
  .header__menu-btn,
  .menu-mobile__fermer {
    padding: 0.4rem;
    border: 1px solid var(--bordure);
    border-radius: 6px;
    background: none;
    cursor: pointer;
  }
  .header__menu-btn {
    display: none;
  }
  .header__menu-btn svg,
  .menu-mobile__fermer svg {
    display: block;
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--brun);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .menu-mobile {
    /* annule le centrage par défaut des popovers : collé en haut, pleine largeur */
    inset: 0 0 auto 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 1rem 1.5rem 2rem;
    border: 0;
    border-radius: 0 0 18px 18px;
    background: var(--blanc);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.15);
    text-align: center;
    translate: 0 -100%;
    transition:
      translate 0.3s ease,
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }
  .menu-mobile:popover-open {
    display: grid;
    gap: 0.25rem;
    translate: 0 0;
  }
  @starting-style {
    .menu-mobile:popover-open {
      translate: 0 -100%;
    }
  }
  .menu-mobile::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
  .menu-mobile__fermer {
    justify-self: end;
  }
  .menu-mobile a:not(.btn) {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--bordure);
    color: var(--texte-fort);
    font-size: 1.15rem;
    text-decoration: none;
  }
  .menu-mobile .btn {
    margin-top: 0.75rem;
  }

  @media (max-width: 640px) {
    .header__nav {
      gap: 0.5rem 0.75rem;
    }
    .header__nav a:not(.btn) {
      display: none;
    }
    .header__menu-btn {
      display: block;
    }
    .header__logo img {
      height: 56px;
    }
  }
</style>
